<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.sifen-sdk</groupId>
    <artifactId>sifen-sdk-parent</artifactId>
    <version>1.0.0-beta.2-SNAPSHOT</version>
  </parent>

  <artifactId>sifen-sdk-core</artifactId>

  <name>SIFEN SDK for Java :: core</name>
  <description>Offline core of the SIFEN SDK: document model, XML, validation, CDC, signing and QR.</description>

  <dependencies>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The SIFEN specification as data (git submodule, pinned). Bundled so the core works offline. -->
      <resource>
        <targetPath>io/github/sifensdk/core/spec</targetPath>
        <directory>${project.basedir}/../spec</directory>
        <includes>
          <include>campos/*.json</include>
          <include>reglas/*.json</include>
          <include>catalogos/*.json</include>
          <include>respuestas/*.json</include>
          <include>servicios.json</include>
          <include>xsd/indice.json</include>
          <include>xsd/oficial/*.xsd</include>
          <include>NOTICE</include>
        </includes>
      </resource>
    </resources>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
      <testResource>
        <targetPath>conformidad</targetPath>
        <directory>${project.basedir}/../spec/conformidad</directory>
      </testResource>
    </testResources>
  </build>
</project>
