<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Standalone on purpose: a BOM must not leak the build's own dependency management to its users. -->
  <groupId>io.github.sifen-sdk</groupId>
  <artifactId>sifen-sdk-bom</artifactId>
  <version>1.0.0-beta.3-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>SIFEN SDK for Java :: BOM</name>
  <description>Bill of materials that aligns the versions of every SIFEN SDK module.</description>
  <url>https://github.com/sifen-sdk/sifen-sdk-java</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>SIFEN SDK contributors</name>
      <url>https://github.com/sifen-sdk/sifen-sdk-java/graphs/contributors</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/sifen-sdk/sifen-sdk-java.git</connection>
    <developerConnection>scm:git:https://github.com/sifen-sdk/sifen-sdk-java.git</developerConnection>
    <url>https://github.com/sifen-sdk/sifen-sdk-java</url>
  </scm>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.sifen-sdk</groupId>
        <artifactId>sifen-sdk-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.sifen-sdk</groupId>
        <artifactId>sifen-sdk-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.sifen-sdk</groupId>
        <artifactId>sifen-sdk-calc</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.sifen-sdk</groupId>
        <artifactId>sifen-sdk-testing</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <!-- The BOM does not inherit the parent's release profile (it is standalone), so it repeats what Maven
       Central needs for a pom-only artifact: signatures and the Central Portal upload. Keep in sync with the
       release profile of the parent pom. -->
  <profiles>
    <profile>
      <id>release</id>
      <properties>
        <central.autoPublish>false</central.autoPublish>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <goals>
                  <goal>sign</goal>
                </goals>
                <phase>verify</phase>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>${central.autoPublish}</autoPublish>
              <waitUntil>validated</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
